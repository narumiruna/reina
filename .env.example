# Bootstrap only. Configure GitHub App, repository, worker, policy, and models in Web UI.
# Copy to a private, untracked .env and run chmod 600 .env.
# Single-quote secrets that contain $ or # to prevent Compose interpolation.
# Generate once with openssl rand -hex 32. Keep the original key with state backups.
ENCRYPTION_KEY=

# HTTPS entrypoint; reverse proxy to 127.0.0.1:36816 and preserve Host.
PUBLIC_URL=https://reina.narumi.dev
PORT=36816
# Compose overrides this with the persistent named volume path.
REINA_STATE_DIR=/var/lib/reina

# Pocket ID confidential client. Missing values lock login; there is no bypass.
# Register exactly https://reina.narumi.dev/auth/callback with scopes openid profile groups.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated exact Pocket ID group Name values; case-sensitive. Empty locks login.
OIDC_ALLOWED_GROUPS=
