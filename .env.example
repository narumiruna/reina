# Bootstrap: copy to a private, untracked .env and run chmod 600 .env.
# Single-quote secrets that contain $ or # to prevent Compose interpolation.
# Required: generate once with openssl rand -hex 32 (64 hexadecimal characters).
# Keep the original key with secure state backups. Do not regenerate for existing state.
ENCRYPTION_KEY=

# HTTPS entrypoint; reverse proxy to 127.0.0.1:36816 and preserve Host.
PUBLIC_URL=https://reina.narumi.dev
PORT=36816

# Pocket ID confidential client. Missing values lock login; there is no bypass.
# Register exactly https://reina.narumi.dev/auth/callback with scopes openid profile groups.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated exact Pocket ID group Name values; case-sensitive.
# Recommend reina-admins after the client owner confirms the deployed ID-token groups claim.
# Any matching group grants full administration; never use a group UUID or Friendly Name.
# Empty locks login; no automatic user administrator group. See docs/admin-webui.md.
OIDC_ALLOWED_GROUPS=

# Dispatch configuration can remain incomplete during Web UI onboarding.
# Upload the GitHub App PEM and configure providers/models in the authenticated UI.
APP_ID=
# At least 32 characters; must match the GitHub App webhook secret.
WEBHOOK_SECRET=
REINA_REPOSITORY=narumiruna/reina
REINA_REPOSITORY_ID=
REINA_INSTALLATION_ID=

# Private persistent directory outside the checkout. Compose uses a named volume
# at this path and overrides custom values. Do not remove the volume on recovery.
REINA_STATE_DIR=/var/lib/reina

# Compose only: separate target checkout at an approved commit.
TARGET_DIR=../reina-target
# Use the immutable image ID printed by prepare-worker, not a mutable tag.
REINA_WORKER_IMAGE=

# Replace with the target repository's security and deployment paths.
REINA_FORBIDDEN_PATHS='["src/auth/**","src/security/**","src/github/**","src/agent/**","src/jobs/**","src/triage/**","src/config.ts","infra/**","deploy/**"]'
