# Probot credentials. Use a secret manager in deployment. Never commit populated values.
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Exactly one explicitly enabled repository and its immutable GitHub identities.
REINA_REPOSITORY=narumiruna/reina
REINA_REPOSITORY_ID=
REINA_INSTALLATION_ID=

# Persistent, service-owned 0700 directory outside this checkout. Do not use /tmp in deployment.
REINA_STATE_DIR=/var/lib/reina

# Output of prepare:worker, not a mutable Docker tag.
REINA_WORKER_IMAGE=
# OpenAI Chat Completions-compatible streaming API supporting max_tokens.
REINA_MODEL=
REINA_MODEL_URL=https://api.openai.com/v1
REINA_MODEL_KEY=

REINA_ALLOWED_PATHS='["README.md","docs/**","src/**","tests/**"]'
# Replace with the actual target repository's security and deployment domains before enabling it.
REINA_FORBIDDEN_PATHS='["src/auth/**","src/security/**","src/github/**","src/agent/**","src/jobs/**","src/triage/**","src/config.ts","infra/**","deploy/**"]'
REINA_VERIFY_COMMANDS='[["npm","run","ci"]]'
REINA_SCAN_INTERVAL_MS=900000
REINA_MAX_ISSUES_PER_SCAN=10
REINA_MAX_CONCURRENT_JOBS=1
REINA_AGENT_TIMEOUT_MS=600000
REINA_MAX_CHANGED_FILES=10
REINA_MAX_PATCH_BYTES=65536
PORT=3000
